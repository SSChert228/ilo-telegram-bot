[Unit]
Description=Private Telegram hardware monitor for HPE iLO 4
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ilo-bot
Group=ilo-bot
WorkingDirectory=/opt/homelab/bots/ilo-telegram-bot
ExecStart=/usr/bin/python3 -B /opt/homelab/bots/ilo-telegram-bot/bot.py --config /etc/ilo-telegram-bot/config.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0077
StateDirectory=ilo-telegram-bot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=20%
TasksMax=24
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
